# API URL for backend REST endpoints (used by axios in api.js)
VITE_API_URL=http://localhost:8080/api

# Base URL for the backend server (used for resolving image URLs)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth Client ID (for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Razorpay Key ID (for payment integration)
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id-here
